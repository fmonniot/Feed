<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.

   Policy: exclude the session-auth DataStore so a restored/transferred backup can never
   carry a live or hijackable login cookie onto another device; the Room article/feed cache
   is left in (it's just a re-sync cache, and shipping it saves a resync after restore).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/ktor_session_cookies.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/ktor_session_cookies.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
