<?xml version="1.0" encoding="utf-8"?><!--
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31; see data_extraction_rules.xml
   for the API 31+ equivalent policy.

   Policy: exclude the session-auth DataStore (same rationale as data_extraction_rules.xml)
   so a full backup can't restore a live login cookie onto another device.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/ktor_session_cookies.preferences_pb"/>
</full-backup-content>
